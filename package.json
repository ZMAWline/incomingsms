{
  "name": "incomingsms",
  "version": "1.0.0",
  "description": "A collection of Cloudflare Workers for handling incoming SMS messages with SIM card management and routing capabilities.",
  "main": "src/dashboard/index.js",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm run check:types && npm run check:builds && npm run check:dashboard && npm test",
    "check:types": "tsc --project tsconfig.json",
    "check:builds": "node scripts/check-builds.mjs",
    "check:dashboard": "node --input-type=module --check < src/dashboard/index.js && node scripts/check-frontend-js.js",
    "test:report-bad": "node tests/report-bad-resolver.test.mjs",
    "test:reports-list-status": "node tests/reports-list-status.test.mjs",
    "check:db-constraints": "node scripts/check_db_constraints.mjs",
    "predeploy": "npm run check && npm run check:db-constraints"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZMAWline/incomingsms.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ZMAWline/incomingsms/issues"
  },
  "homepage": "https://github.com/ZMAWline/incomingsms#readme",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260219.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  }
}
